<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Floating round navigate-up button (48dp, elevation 8dp). -->
    <style name="OneUI.FloatingNavigateUp" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/oui_des_floating_navigate_up_bg</item>
        <item name="android:src">@drawable/oui_des_ic_navigate_up</item>
        <item name="android:minWidth">@dimen/oui_des_floating_navigate_up_size</item>
        <item name="android:minHeight">@dimen/oui_des_floating_navigate_up_size</item>
        <item name="android:scaleType">center</item>
        <item name="android:elevation">@dimen/oui_des_floating_navigate_up_elevation</item>
        <item name="android:contentDescription">@string/abc_action_bar_up_description</item>
        <item name="tint">@color/oui_des_floating_navigate_up_icon_color</item>
    </style>

    <style name="OneUI.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/oui_des_button_min_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">@dimen/oui_des_button_text_size</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/oui_des_button_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/oui_des_button_padding_horizontal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="OneUI.Button.Contained">
        <item name="android:background">@drawable/oui_des_btn_contained_bg</item>
        <item name="android:textColor">@color/oui_des_sys_on_surface_container_fixed</item>
    </style>
    <style name="OneUI.Button.Contained.Small">
        <item name="android:background">@drawable/oui_des_btn_contained_small_bg</item>
    </style>
    <style name="OneUI.Button.Tonal">
        <item name="android:background">@drawable/oui_des_btn_tonal_bg</item>
        <item name="android:textColor">@color/oui_des_sys_on_surface_container_highest</item>
    </style>
    <style name="OneUI.Button.Tonal.Small">
        <item name="android:background">@drawable/oui_des_btn_tonal_small_bg</item>
    </style>
</resources>
